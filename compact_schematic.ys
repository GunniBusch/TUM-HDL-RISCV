read_verilog src/*.v
hierarchy -check -top rv_pl
proc

# Preserve ONLY major high-level modules for maximum compactness
# Grouping:
# - Controller (Decision making)
# - ALU (Calculation)
# - RegFile (State)
# - Memories (Storage)
# - HazardUnit (Pipeline Control)

select -module controller
setattr -mod -set keep_hierarchy 1
select -clear

select -module alu
setattr -mod -set keep_hierarchy 1
select -clear

select -module reg_file
setattr -mod -set keep_hierarchy 1
select -clear

select -module hazard_unit
setattr -mod -set keep_hierarchy 1
select -clear

select -module inst_mem
setattr -mod -set keep_hierarchy 1
select -clear

select -module data_mem
setattr -mod -set keep_hierarchy 1
select -clear

# REMOVED: sign_extend (just wires/concatenation)
# REMOVED: alu_decoder (small combinatorial logic, best inside controller or loose)

# Flatten everything else
flatten

# Aggressive optimization to remove buffers, inverters, and constant wires
# This significantly reduces the edge count in the graph
opt -full
opt_clean -purge

# Write the compact JSON
write_json rv_pl_compact.json
